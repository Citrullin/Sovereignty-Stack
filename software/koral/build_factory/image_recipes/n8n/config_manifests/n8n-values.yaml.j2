config:
  DB_TYPE: postgresdb
  DB_POSTGRESDB_HOST: "n8n-postgresql.n8n.svc.cluster.local"
  DB_POSTGRESDB_PORT: "5432"
  DB_POSTGRESDB_DATABASE: "n8n"
  DB_POSTGRESDB_USER: "n8n"
  DB_POSTGRESDB_PASSWORD: "n8npassword"
  WEBHOOK_URL: "https://n8n.{{ homelab_domain }}/"
  NODE_ENV: "production"
  N8N_METRICS: "true"

secret:
  N8N_ENCRYPTION_KEY: "n8n-encryption-key-homelab"

database:
  type: postgresdb
  postgresdb:
    host: "n8n-postgresql.n8n.svc.cluster.local"
    port: 5432
    database: "n8n"
    user: "n8n"
    password: "n8npassword"

main:
  extraEnv:
    - name: SSL_CERT_FILE
      value: /etc/ssl/certs/homelab-ca.crt
    - name: NODE_EXTRA_CA_CERTS
      value: /etc/ssl/certs/homelab-ca.crt
  
  extraVolumes:
    - name: ca-certs
      configMap:
        name: homelab-ca
  
  extraVolumeMounts:
    - name: ca-certs
      mountPath: /etc/ssl/certs/homelab-ca.crt
      subPath: homelab-ca.crt
      readOnly: true
