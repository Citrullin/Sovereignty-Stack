
ingress:
  enabled: false
  className: istio
  hosts:
    - host: erpnext.{{ homelab_domain }}
      paths:
        - path: /
          pathType: Prefix
          
hostAliases:
  - ip: "{{ istio_ingress_ip }}"
    hostnames:
      - "authentik.{{ homelab_domain }}"
      - "nextcloud.{{ homelab_domain }}"
      - "coder.{{ homelab_domain }}"
      - "taiga.{{ homelab_domain }}"
      - "erpnext.{{ homelab_domain }}"

# ERPNext specific minimal configuration
mariadb:
  enabled: false

mariadb-sts:
  enabled: true
  auth:
    rootPassword: "changeit"
    password: "changeit"
  primary:
    resources:
      requests:
        cpu: 50m
        memory: 256Mi
      limits:
        cpu: 1000m
        memory: 512Mi

dbHost: erpnext-mariadb-sts.erpnext.svc.cluster.local
dbPort: 3306
dbSecret: erpnext
dbPasswordKey: mariadb-root-password
dbUser: root
dbRootUser: root

persistence:
  worker:
    enabled: true
    storageClass: "local-path"
    accessModes: [ReadWriteOnce]
    size: 2Gi
  logs:
    enabled: true
    storageClass: "local-path"
    accessModes: [ReadWriteOnce]
    size: 1Gi

jobs:
  createSite:
    siteName: erpnext.{{ homelab_domain }}

  # Use the fully qualified domain name for reliable internal resolution
  backend: erpnext-gunicorn.erpnext.svc.cluster.local:8000
  socketio: erpnext-socketio.erpnext.svc.cluster.local:9000

  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      cpu: 100m
      memory: 128Mi
  service:
    https:
      enabled: true
      port: 443
      targetPort: 443
  extraContainers:
    - name: nginx-sidecar
      image: nginx:stable-alpine
      resources:
        requests:
          cpu: 10m
          memory: 32Mi
        limits:
          cpu: 50m
          memory: 64Mi
      ports:
        - name: https-internal
          containerPort: 443
      volumeMounts:
        - name: erpnext-tls
          mountPath: /etc/nginx/certs
          readOnly: true
        - name: erpnext-nginx-ssl-conf
          mountPath: /etc/nginx/conf.d/default.conf
          subPath: default.conf
          readOnly: true
  extraVolumes:
    - name: erpnext-tls
      secret:
        secretName: erpnext-tls
    - name: erpnext-nginx-ssl-conf
      configMap:
        name: erpnext-nginx-ssl-conf
    - name: homelab-ca
      configMap:
        name: homelab-ca
    - name: erpnext-oidc-patches
      configMap:
        name: erpnext-oidc-patches

socketio:
  envVars:
    - name: REQUESTS_CA_BUNDLE
      value: /home/frappe/frappe-bench/sites/homelab-ca.crt
    - name: SSL_CERT_FILE
      value: /home/frappe/frappe-bench/sites/homelab-ca.crt
  volumeMounts:
    - name: homelab-ca
      mountPath: /home/frappe/frappe-bench/sites/homelab-ca.crt
      subPath: homelab-ca.crt
      readOnly: true
    - mountPath: /home/frappe/frappe-bench/apps/frappe/realtime/index.js
      name: erpnext-oidc-patches
      subPath: frappe-realtime-index.js
      readOnly: true
    - mountPath: /home/frappe/frappe-bench/apps/frappe/realtime/middlewares/authenticate.js
      name: erpnext-oidc-patches
      subPath: frappe-realtime-authenticate.js
      readOnly: true

worker:
  resources:
    requests:
      cpu: 50m
      memory: 256Mi
    limits:
      cpu: 1000m
      memory: 1536Mi
  volumeMounts:
    - name: homelab-ca
      mountPath: /home/frappe/frappe-bench/sites/homelab-ca.crt
      subPath: homelab-ca.crt
      readOnly: true
    - mountPath: /home/frappe/frappe-bench/apps/frappe/realtime/index.js
      name: erpnext-oidc-patches
      subPath: frappe-realtime-index.js
      readOnly: true
    - mountPath: /home/frappe/frappe-bench/apps/frappe/realtime/middlewares/authenticate.js
      name: erpnext-oidc-patches
      subPath: frappe-realtime-authenticate.js
      readOnly: true
    - mountPath: /home/frappe/frappe-bench/apps/frappe/frappe/integrations/oauth2_logins.py
      name: erpnext-oidc-patches
      subPath: oauth2_logins.py
    - mountPath: /home/frappe/frappe-bench/apps/frappe/frappe/utils/oauth.py
      name: erpnext-oidc-patches
      subPath: oauth.py
    - mountPath: /home/frappe/frappe-bench/apps/frappe/frappe/core/doctype/user/user.py
      name: erpnext-oidc-patches
      subPath: user.py
  gunicorn:
    envVars:
      - name: REQUESTS_CA_BUNDLE
        value: /home/frappe/frappe-bench/sites/homelab-ca.crt
      - name: SSL_CERT_FILE
        value: /home/frappe/frappe-bench/sites/homelab-ca.crt
    volumeMounts:
      - name: homelab-ca
        mountPath: /home/frappe/frappe-bench/sites/homelab-ca.crt
        subPath: homelab-ca.crt
        readOnly: true
      - mountPath: /home/frappe/frappe-bench/apps/frappe/frappe/integrations/oauth2_logins.py
        name: erpnext-oidc-patches
        subPath: oauth2_logins.py
      - mountPath: /home/frappe/frappe-bench/apps/frappe/frappe/utils/oauth.py
        name: erpnext-oidc-patches
        subPath: oauth.py
      - mountPath: /home/frappe/frappe-bench/apps/frappe/frappe/core/doctype/user/user.py
        name: erpnext-oidc-patches
        subPath: user.py
  default:
    envVars:
      - name: REQUESTS_CA_BUNDLE
        value: /home/frappe/frappe-bench/sites/homelab-ca.crt
      - name: SSL_CERT_FILE
        value: /home/frappe/frappe-bench/sites/homelab-ca.crt
  short:
    envVars:
      - name: REQUESTS_CA_BUNDLE
        value: /home/frappe/frappe-bench/sites/homelab-ca.crt
      - name: SSL_CERT_FILE
        value: /home/frappe/frappe-bench/sites/homelab-ca.crt
  long:
    envVars:
      - name: REQUESTS_CA_BUNDLE
        value: /home/frappe/frappe-bench/sites/homelab-ca.crt
      - name: SSL_CERT_FILE
        value: /home/frappe/frappe-bench/sites/homelab-ca.crt
